{
  "name": "lms-plugin-context-bridge",
  "version": "0.1.0",
  "description": "LM Studio context compaction integration with external-generator token budgeting.",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "install-plugin": "lms dev --install -y",
    "discover": "pnpm run build && node discover.js",
    "smoke": "pnpm run build && node scripts/runtime-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@lmstudio/sdk": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
